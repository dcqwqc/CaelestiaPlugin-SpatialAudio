[Unit]
Description=Caelestia Spatial Audio PipeWire controller
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=simple
ExecStart=%h/.local/share/caelestia/plugins/spatialaudio/scripts/spatial-audio-controller.py serve
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
